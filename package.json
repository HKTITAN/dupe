{
  "name": "@hktitan/dupe",
  "version": "0.1.3",
  "description": "Run any desktop app as several isolated, colour-coded profiles on macOS, Windows and Linux.",
  "type": "module",
  "bin": {
    "dupe": "bin/dupe.js"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "skills",
    "plugin.json",
    "mcp.json",
    ".mcp.json",
    ".claude-plugin",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "build:web": "node scripts/build-web.js",
    "build:embed": "node scripts/build-web.js && node scripts/build-embed.js",
    "build:bin": "node scripts/build-web.js && node scripts/build-embed.js && node scripts/build-bin.js"
  },
  "keywords": [
    "electron",
    "profiles",
    "work",
    "personal",
    "multi-account",
    "icon",
    "claude",
    "chatgpt"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HKTITAN/dupe.git"
  },
  "homepage": "https://hktitan.github.io/dupe/",
  "bugs": {
    "url": "https://github.com/HKTITAN/dupe/issues"
  },
  "author": "Harshit Khemani (https://github.com/HKTITAN)"
}
